{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.ffucucuoglu/linkfetch-mcp",
  "title": "LinkFetch: LinkedIn MCP",
  "description": "LinkedIn for Claude: jobs, profiles, companies, people search, posts and inbox.",
  "websiteUrl": "https://linkfetch.io/mcp/claude",
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "linkfetch-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LINKFETCH_API_KEY",
          "description": "API key from linkfetch.io/dashboard (sk_live_\u2026)",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "repository": {
    "url": "https://github.com/ffucucuoglu/linkedin-mcp-server",
    "source": "github"
  }
}
